                "html": "<style>\n  body {\n    display: grid;\n    place-items: center;\n    background: linear-gradient(120deg, #f97316, #db2777, #7c3aed, #2563eb);\n    background-size: 300% 300%;\n    animation: fundo 8s ease infinite;\n  }\n  .capa {\n    text-align: center;\n  }\n  h1 {\n    margin: 0;\n    font-size: 140px;\n    letter-spacing: -4px;\n  }\n  p {\n    margin: 20px 0 0;\n    font-size: 48px;\n    opacity: 0.9;\n  }\n  @keyframes fundo {\n    50% {\n      background-position: 100% 50%;\n    }\n  }\n</style>\n<div class=\"capa\">\n  <h1>Título da aula</h1>\n  <p>Subtítulo · Professor · Data</p>\n</div>",
