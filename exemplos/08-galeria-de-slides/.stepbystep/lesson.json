            "actions": [
              {
                "id": "08-galeria-de-slides-5",
                "kind": "SLIDE",
                "format": "html",
                "markdown": "",
                "html": "<style>\n  body {\n    padding: 120px 160px;\n    box-sizing: border-box;\n    background: #0f172a;\n  }\n  h2 {\n    margin: 0 0 60px;\n    font-size: 84px;\n    color: #38bdf8;\n  }\n  li {\n    margin: 28px 0;\n    font-size: 56px;\n    list-style: none;\n    opacity: 0;\n    animation: entrar 600ms ease forwards;\n  }\n  li::before {\n    content: '→ ';\n    color: #f472b6;\n  }\n  li:nth-child(2) {\n    animation-delay: 0.6s;\n  }\n  li:nth-child(3) {\n    animation-delay: 1.2s;\n  }\n  li:nth-child(4) {\n    animation-delay: 1.8s;\n  }\n  @keyframes entrar {\n    from {\n      opacity: 0;\n      transform: translateX(-60px);\n    }\n    to {\n      opacity: 1;\n      transform: none;\n    }\n  }\n</style>\n<h2>O que vamos ver</h2>\n<ul>\n  <li>Primeiro tópico</li>\n  <li>Segundo tópico</li>\n  <li>Terceiro tópico</li>\n  <li>Prática no final</li>\n</ul>",
                "transition": "slide-left"
              }
            ]
          }
